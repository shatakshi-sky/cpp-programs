
#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;

int main() {
    srand(time(0));

    int toss = rand() % 2;

    cout << "=== Coin Toss Simulator ===" << endl;

    if (toss == 0) {
        cout << "Result: Heads!" << endl;
    } else {
        cout << "Result: Tails!" << endl;
    }

    return 0;
}
