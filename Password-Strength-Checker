#include <iostream>
#include <string>
#include <cctype>

using namespace std;

int main() {

    string password;
    int score = 0;

    bool hasUpper = false;
    bool hasLower = false;
    bool hasNumber = false;
    bool hasSpecial = false;

    cout << "===============================\n";
    cout << "    PASSWORD STRENGTH CHECKER\n";
    cout << "===============================\n";

    cout << "Enter your password: ";
    cin >> password;

    // Check password length
    if (password.length() >= 8) {
        score++;
    }

    // Check each character
    for (char ch : password) {

        if (isupper(ch)) {
            hasUpper = true;
        }
        else if (islower(ch)) {
            hasLower = true;
        }
        else if (isdigit(ch)) {
            hasNumber = true;
        }
        else {
            hasSpecial = true;
        }
    }

    // Add points
    if (hasUpper)
        score++;

    if (hasLower)
        score++;

    if (hasNumber)
        score++;

    if (hasSpecial)
        score++;

    // Display results
    cout << "\n---------- RESULT ----------\n";

    cout << "Length: " << password.length() << "\n";

    cout << "Uppercase letter: "
         << (hasUpper ? "Yes" : "No") << "\n";

    cout << "Lowercase letter: "
         << (hasLower ? "Yes" : "No") << "\n";

    cout << "Number: "
         << (hasNumber ? "Yes" : "No") << "\n";

    cout << "Special character: "
         << (hasSpecial ? "Yes" : "No") << "\n";

    cout << "\nScore: " << score << "/5\n";

    if (score <= 2) {
        cout << "Strength: WEAK\n";
    }
    else if (score <= 4) {
        cout << "Strength: MEDIUM\n";
    }
    else {
        cout << "Strength: STRONG\n";
    }

    return 0;
}
