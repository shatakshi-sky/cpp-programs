
#include <iostream>
#include <cstdlib>
#include <ctime>
#include <string>
using namespace std;

int main() {
    srand(time(0));

    string characters =
        "abcdefghijklmnopqrstuvwxyz"
        "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        "0123456789!@#$%";

    int length;

    cout << "=== Password Generator ===\n";
    cout << "Enter password length: ";
    cin >> length;

    if (length < 1 || length > 100) {
        cout << "Please enter a length between 1 and 100.\n";
        return 0;
    }

    string password = "";

    for (int i = 0; i < length; i++) {
        password += characters[rand() % characters.length()];
    }

    cout << "Generated Password: " << password << endl;

    return 0;
}
