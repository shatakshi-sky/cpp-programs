
#include <iostream>
#include <vector>
#include <string>
using namespace std;

struct Task {
    string subject;
    string description;
    bool completed = false;
};

void showMenu() {
    cout << "\n========== STUDY PLANNER ==========\n";
    cout << "1. Add a study task\n";
    cout << "2. View all tasks\n";
    cout << "3. Mark a task as completed\n";
    cout << "4. Exit\n";
    cout << "===================================\n";
    cout << "Enter your choice: ";
}

void addTask(vector<Task>& tasks) {
    Task newTask;

    cout << "Enter subject: ";
    getline(cin, newTask.subject);

    cout << "Enter task description: ";
    getline(cin, newTask.description);

    tasks.push_back(newTask);

    cout << "Task added successfully!\n";
}

void viewTasks(const vector<Task>& tasks) {
    if (tasks.empty()) {
        cout << "No tasks added yet.\n";
        return;
    }

    cout << "\n---------- YOUR TASKS ----------\n";

    for (int i = 0; i < tasks.size(); i++) {
        cout << i + 1 << ". "
             << tasks[i].subject << " - "
             << tasks[i].description << "\n";

        if (tasks[i].completed) {
            cout << "   Status: Completed\n";
        } else {
            cout << "   Status: Pending\n";
        }
    }
}

void completeTask(vector<Task>& tasks) {
    if (tasks.empty()) {
        cout << "No tasks available to complete.\n";
        return;
    }

    viewTasks(tasks);

    int number;
    cout << "Enter the task number to complete: ";

    if (!(cin >> number)) {
        cout << "Please enter a valid number.\n";
        cin.clear();
        cin.ignore(10000, '\n');
        return;
    }

    cin.ignore(10000, '\n');

    if (number < 1 || number > tasks.size()) {
        cout << "Invalid task number.\n";
        return;
    }

    tasks[number - 1].completed = true;
    cout << "Task marked as completed!\n";
}

int main() {
    vector<Task> tasks;
    string choice;

    while (true) {
        showMenu();
        getline(cin, choice);

        if (choice == "1") {
            addTask(tasks);
        } else if (choice == "2") {
            viewTasks(tasks);
        } else if (choice == "3") {
            completeTask(tasks);
        } else if (choice == "4") {
            cout << "Happy studying! Goodbye.\n";
            break;
        } else {
            cout << "Invalid choice. Please select 1-4.\n";
        }
    }

    return 0;
}
